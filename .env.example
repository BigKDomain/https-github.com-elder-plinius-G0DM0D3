# Message template — use {name} as a placeholder for the lead's name/business name
MESSAGE_TEMPLATE=Hi {name}, I came across your business and wanted to reach out. I'd love to connect and see if there's a fit — would you be open to a quick chat?

# Delay between messages in milliseconds (default: 3000 = 3 seconds)
# Increase this to reduce the chance of being flagged for spam
DELAY_MS=3000

# CSV column names (adjust to match your file's headers)
NAME_COLUMN=Business Name
PHONE_COLUMN=Phone

# Country code to prepend when a number starts with 0 (e.g. 234 for Nigeria)
COUNTRY_CODE=234
