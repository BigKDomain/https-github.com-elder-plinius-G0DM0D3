# Message template — use {name} as a placeholder for the lead's name
MESSAGE_TEMPLATE=Hi {name}, I came across your profile and wanted to reach out. I'd love to connect and see if there's a fit — would you be open to a quick chat?

# Delay between messages in milliseconds (default: 3000 = 3 seconds)
# Increase this to reduce the chance of being flagged for spam
DELAY_MS=3000
